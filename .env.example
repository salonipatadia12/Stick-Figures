# Keep real credentials in .env or your host's secret settings, never in Git.
# auto selects Anthropic when its key is set, otherwise OpenAI.
STORY_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_STORY_MODEL=claude-sonnet-5-5
# Optional, for keys that require a specific workspace.
ANTHROPIC_WORKSPACE_ID=
# Optional alternative story provider; also required for NEW AI illustrations.
OPENAI_API_KEY=
STORY_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-2
# Required for Docker/production. Use a long unique password.
APP_USERNAME=owner
APP_PASSWORD=

# --- pipeline-v2 (`stick`) ---
# Scripts use ANTHROPIC_API_KEY above (model claude-sonnet-5-5); images use OPENAI_API_KEY + IMAGE_MODEL.
# Narrator for finished videos. edge-tts (free, no key) is used only for drafts and previews.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional alternative image provider.
GEMINI_API_KEY=
