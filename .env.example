# Keep real credentials in .env or your host's secret settings, never in Git.

# --- pipeline-v2 (`stick`): research, storylines and scripts ---
# Script generation: ollama (free, local) or anthropic (paid API).
SCRIPT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# qwen3.5:9b (Apache-2.0, 6.6 GB; chosen 2026-11-11 over qwen2.5:14b). Pull it once: ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b
# Optional tuning (defaults shown): context per call, concurrent model calls, unload the model when a step ends
# OLLAMA_NUM_CTX=4096
# OLLAMA_PARALLEL=2
# OLLAMA_UNLOAD=1
# Search: DuckDuckGo first, then ddgs's other keyless engines. Shared page cache (default <repo>/cache).
# SEARCH_BACKENDS=duckduckgo,auto
# STICK_CACHE_DIR=

# Only needed if SCRIPT_PROVIDER=anthropic (and for the studio's story drafting below)
# ANTHROPIC_API_KEY=sk-ant-...

# --- studio (rig lane): story drafting ---
STORY_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_STORY_MODEL=claude-sonnet-5-5
# Optional, for keys that require a specific workspace.
ANTHROPIC_WORKSPACE_ID=
# Required for Docker/production. Use a long unique password.
APP_USERNAME=owner
APP_PASSWORD=

# --- pipeline-v2 (`stick`): images and narration ---
# With SCRIPT_PROVIDER=ollama nothing in the pipeline is paid: images (FLUX), voice (Kokoro), research (DuckDuckGo)
# and scripts (Ollama) all run on this machine with no keys. See docs/LOCAL_MODELS.md for the engines, licences, setup.
