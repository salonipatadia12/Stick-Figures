# Keep real credentials in .env or your host's secret settings, never in Git.
# Story drafting (studio) and scripts (pipeline-v2) use Anthropic.
STORY_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_STORY_MODEL=claude-sonnet-5-5
# Optional, for keys that require a specific workspace.
ANTHROPIC_WORKSPACE_ID=
# Required for Docker/production. Use a long unique password.
APP_USERNAME=owner
APP_PASSWORD=

# --- pipeline-v2 (`stick`) ---
# Only the script step is paid: ANTHROPIC_API_KEY above, model claude-sonnet-5-5.
# Images and narration run on open-source models on this machine and need no keys.
# See docs/LOCAL_MODELS.md for the engines, their licences and setup.
