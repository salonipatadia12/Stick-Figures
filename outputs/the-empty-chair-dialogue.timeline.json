  "speech_cues": [
    [
      0.35,
      3.1599999999999997,
      "Every morning, she drew at the same caf\u00e9."
    ],
    [
      3.1599999999999997,
      6.33,
      "And every morning, her bag took the other chair."
    ],
    [
      6.53,
      9.301,
      "Until someone asked, \u201cMind if I sit?\u201d"
    ],
    [
      9.601,
      11.779,
      "She hesitated... then moved it."
    ],
    [
      11.779,
      13.351,
      "He noticed her sketchbook."
    ],
    [
      13.351,
      15.155000000000001,
      "\u201cWait... you drew this?\u201d"
    ],
    [
      15.155000000000001,
      17.436,
      "They talked until their coffee went cold."
    ],
    [
      17.986,
      20.551000000000002,
      "The next morning, she saved his seat."
    ],
    [
      21.351000000000003,
      22.485000000000003,
      "Then the next."
    ],
    [
      22.935000000000002,
      25.499000000000002,
      "By the fourth morning, the bag was back."
    ],
    [
      26.399,
      29.479,
      "That's when she heard, \u201cI tried drawing our table.\u201d"
    ],
    [
      29.479,
      30.922,
      "He held up a sketchbook."
    ],
    [
      30.922,
      32.056000000000004,
      "Crooked legs."
    ],
    [
      32.056000000000004,
      33.422000000000004,
      "Cups like potatoes."
    ],
    [
      33.672000000000004,
      35.386,
      "She laughed, moved her bag..."
    ],
    [
      35.386,
      37.1,
      "and pulled out his chair."
    ]
  ],
