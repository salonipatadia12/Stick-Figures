  "speech_cues": [
    [
      0.45263157894736844,
      3.7894736842105265,
      "Every morning, she sat at the same caf\u00e9 table."
    ],
    [
      3.7894736842105265,
      5.805263157894737,
      "Her sketchbook on the table."
    ],
    [
      5.805263157894737,
      7.736842105263158,
      "Her bag on the other chair."
    ],
    [
      7.736842105263158,
      11.369473684210526,
      "One day, a man asked, \u201cIs this seat taken?\u201d"
    ],
    [
      11.369473684210526,
      14.101052631578948,
      "She hesitated... then moved her bag."
    ],
    [
      14.101052631578948,
      17.475789473684213,
      "They sat quietly, until he noticed her drawing."
    ],
    [
      17.475789473684213,
      19.19263157894737,
      "\u201cYou drew this place?\u201d"
    ],
    [
      19.19263157894737,
      20.250526315789475,
      "She nodded."
    ],
    [
      20.250526315789475,
      21.766315789473683,
      "And they started talking."
    ],
    [
      22.266315789473683,
      25.242105263157896,
      "The next morning, she left his chair empty."
    ],
    [
      25.242105263157896,
      26.52842105263158,
      "But he didn't come."
    ],
    [
      27.52842105263158,
      30.103157894736842,
      "For three days, she watched the door."
    ],
    [
      30.103157894736842,
      32.734736842105264,
      "On the fourth, she put her bag back."
    ],
    [
      33.28473684210526,
      36.502631578947366,
      "Then she heard, \u201cI tried drawing our table.\u201d"
    ],
    [
      36.502631578947366,
      38.26157894736842,
      "He was holding a sketchbook."
    ],
    [
      38.26157894736842,
      39.79210526315789,
      "The table was crooked."
    ],
    [
      39.79210526315789,
      41.76578947368421,
      "The cups looked like potatoes."
    ],
    [
      42.06578947368421,
      45.87,
      "She laughed, moved her bag... and pulled out his chair."
    ]
  ]
}