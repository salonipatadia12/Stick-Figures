  "sources": [
    {
      "id": "s1",
      "claim": "On April 10, 1815, Tambora produced the largest eruption in recorded history; its ash reduced the sunlight reaching the surface, causing global cooling and the 1816 \"year without a summer\".",
      "url": "https://science.nasa.gov/earth/earth-observatory/mount-tambora-volcano-sumbawa-island-indonesia-39412",
      "title": "NASA Earth Observatory: Mount Tambora Volcano, Sumbawa Island, Indonesia",
      "quote": "On April 10, 1815, the Tambora Volcano produced the largest eruption in recorded history."
    },
    {
      "id": "s2",
      "claim": "Large eruptions send sulfur dioxide into the stratosphere, where it forms fine sulfate aerosols that increase the reflection of sunlight back into space; several eruptions cooled the Earth for one to three years, and Tambora 1815 disturbed the stratosphere more than Pinatubo did.",
      "url": "https://www.usgs.gov/programs/VHP/volcanoes-can-affect-climate",
      "title": "USGS Volcano Hazards Program: Volcanoes Can Affect Climate",
      "quote": "The aerosols increase the reflection of radiation from the Sun back into space."
    },
