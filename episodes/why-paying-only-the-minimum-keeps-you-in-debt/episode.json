  "sources": [
    {
      "id": "s1",
      "claim": "Many credit card companies calculate the interest you owe daily, based on your average daily account balance.",
      "url": "https://www.consumerfinance.gov/ask-cfpb/how-does-my-credit-card-company-calculate-the-amount-of-interest-i-owe-en-51/",
      "title": "How does my credit card company calculate the amount of interest I owe?",
      "quote": ""
    },
    {
      "id": "s2",
      "claim": "The daily periodic rate is the APR divided by 365, and it is applied to each day's balance in the billing cycle.",
      "url": "https://www.consumerfinance.gov/data-research/credit-card-data/know-you-owe-credit-cards/credit-card-contract-definitions/",
      "title": "Credit card contract definitions",
      "quote": ""
    },
    {
      "id": "s3",
      "claim": "The Federal Reserve notes that a monthly bill shows how long payoff takes on minimum payments only, plus the monthly payment that would pay off the balance in three years.",
      "url": "https://www.federalreserve.gov/consumerinfo/wyntk/wyntk_ccrules.pdf",
      "title": "The Federal Reserve Board www.federalreserve.gov WHAT YOU NEED TO KNOW:",
      "quote": ""
    },
    {
      "id": "s4",
      "claim": "The Federal Reserve's example is a $3,000 balance at 14.4% interest, where paying only the minimum takes 11 years and about $4,745 in total, while $103 a month pays it off in 3 years for $3,712.",
      "url": "https://www.federalreserve.gov/consumerinfo/wyntk/wyntk_ccrules.pdf",
      "title": "The Federal Reserve Board www.federalreserve.gov WHAT YOU NEED TO KNOW:",
      "quote": ""
    },
    {
      "id": "s5",
      "claim": "Federal rules require the statement's repayment estimate to be disclosed in months if it is under 2 years, and otherwise in years rounded to the nearest whole year.",
      "url": "https://www.consumerfinance.gov/rules-policy/regulations/1026/7/",
      "title": "§ 1026.7 Periodic statement.",
      "quote": ""
    }
