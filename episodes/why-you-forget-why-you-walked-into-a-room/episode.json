  "sources": [
    {
      "id": "s1",
      "claim": "Entering or exiting through a doorway acts as an \"event boundary\" in the mind, which separates episodes of activity and files them away, according to University of Notre Dame psychologist Gabriel Radvansky.",
      "url": "https://news.nd.edu/news/walking-through-doorways-causes-forgetting-new-research-shows/",
      "title": "Walking through doorways causes forgetting, new research shows",
      "quote": "“Entering or exiting through a doorway serves as an ‘event boundary’ in the mind, which separates episodes of activity and files them away,” Radvansky..."
    },
    {
      "id": "s2",
      "claim": "In Radvansky's experiments, people forgot more after walking through a doorway than after moving the same distance across a single room.",
      "url": "https://news.nd.edu/news/walking-through-doorways-causes-forgetting-new-research-shows/",
      "title": "Walking through doorways causes forgetting, new research shows",
      "quote": "Radvansky found that the subjects forgot more after walking through a doorway compared to moving the same distance across a room, suggesting that the ..."
    },
    {
      "id": "s3",
      "claim": "When subjects passed through several doorways and ended up back in the room where they started, their memory did not improve, which suggests the doorway files the memory away rather than the room itself being the cue.",
      "url": "https://al.nd.edu/news/latest-news/walking-through-doorways-causes-forgetting-new-research-shows/",
      "title": "Psychologist Gabriel Radvansky: Walking Through Doorways Causes Forgetting",
      "quote": "Subjects in this leg of the study passed through several doorways, leading back to the room in which they started. The results showed no improvements ..."
    },
    {
      "id": "s4",
      "claim": "Passing through doorways that joined identical rooms mostly didn't affect memory, perhaps because the context didn't change enough to create a significant event boundary.",
      "url": "https://www.sciencefocus.com/science/psychology-doorway-effect-memory",
      "title": "The 'doorway effect': Why you lose your train of thought the moment you enter a new room",
      "quote": "They found that passing through doorways that joined identical rooms mostly didn’t impact memory – perhaps because there wasn’t enough of a changed co..."
    },
    {
      "id": "s6",
      "claim": "Across four experiments (McFadyen, Nolan, Pinocy, Buteri and Baumann, BMC Psychology 2021), doorways had no significant effect on forgetting, except under working-memory load, when memory was more susceptible to interference after moving through doorways.",
      "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7938580/",
      "title": "McFadyen et al. 2021, Doorways do not always cause forgetting: a multimodal investigation, BMC Psychology 9:41",
      "quote": "Across this series of experiments, we observed no significant effect of doorways on forgetting."
    }
  ],
