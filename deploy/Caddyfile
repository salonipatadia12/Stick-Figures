# LOCAL DEVELOPMENT ONLY (compose profile "caddy"). On the VPS the host's nginx fronts the app
# (deploy/nginx/stick.conf + certbot); Caddy is never started there.
# Site = PUBLIC_URL, e.g. https://localhost:18443 with Caddy's internal CA (CADDY_GLOBAL_OPTIONS defaults to
# `local_certs skip_install_trust`). Ports are the same inside and outside the container.
{
	http_port {$CADDY_HTTP_PORT:80}
	https_port {$CADDY_HTTPS_PORT:443}
	{$CADDY_GLOBAL_OPTIONS}
	servers {
		timeouts {
			read_body 15m
		}
	}
}

{$PUBLIC_URL} {
	encode zstd gzip

	# the Mac uploads the finished MP4 and previews here
	request_body {
		max_size 2GB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy web:8000

	log {
		output stdout
		format console
	}
}
