# /srv/stick/.env on the VPS: owner deploy, mode 600 (`chmod 600 /srv/stick/.env`). Never commit the real one.
# Values with no spaces. A value containing `$` (the password hash) goes in 'single quotes', or Compose would
# read the `$` as a variable. Make random values with: openssl rand -hex 32

# Where the site lives: the host's nginx serves it (deploy/nginx/stick.conf + certbot) and proxies to the app.
PUBLIC_URL=https://stick.srv1747356.hstgr.cloud
# The app's host port (127.0.0.1 only; nginx proxies to it). Change it here and in deploy/nginx/stick.conf together.
# WEB_PORT=8020

# Postgres (hex only, so it is safe inside DATABASE_URL)
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24
# Optional; built from POSTGRES_PASSWORD when unset:
# DATABASE_URL=postgresql+psycopg://stick:<POSTGRES_PASSWORD>@postgres:5432/stick

# The single login. Hash from: docker compose ... run --rm web python -m webapp.hashpw
APP_USER=you
APP_PASSWORD_HASH='scrypt$<salt hex>$<hash hex>'
SESSION_SECRET=change-me-openssl-rand-hex-32

# sha256 hex of the Mac worker's bearer token (the VPS never stores the token itself). See deploy/README.md.
WORKER_TOKEN_SHA256=change-me-sha256-hex

# The only paid key (Anthropic: research, storylines, script)
ANTHROPIC_API_KEY=sk-ant-change-me
SPEND_PREAPPROVED_USD=0.50

# Tests only: fake Anthropic client, nothing paid is sent
# STICK_FAKE_ANTHROPIC=1

# Local development only (compose profile "caddy"; never on the VPS):
# PUBLIC_URL=https://localhost:18443
# CADDY_HTTP_PORT=18080
# CADDY_HTTPS_PORT=18443
# CADDY_GLOBAL_OPTIONS=local_certs skip_install_trust
